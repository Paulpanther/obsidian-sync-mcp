# Builds the server from source, for platforms that build straight from Git
# (Dokploy, Coolify, plain `docker build -f Dockerfile.source .`).
# The CI image (Dockerfile) instead copies a dist/ built beforehand.

FROM node:22-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
# Git checkouts without submodules leave lib/livesync-commonlib empty: fetch the pinned commit.
ARG LIVESYNC_COMMONLIB_REF=50d4ab9c1a7d4f59ab29c7555b8dfb2d69555e92
RUN if [ ! -f lib/livesync-commonlib/package.json ]; then \
      rm -rf lib/livesync-commonlib && mkdir -p lib/livesync-commonlib && cd lib/livesync-commonlib && \
      git init -q && git remote add origin https://github.com/vrtmrz/livesync-commonlib.git && \
      git fetch -q --depth 1 origin "$LIVESYNC_COMMONLIB_REF" && git checkout -q FETCH_HEAD; \
    fi
RUN npm ci && npm run build

FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist/ dist/
# Run as the image's "node" user (UID/GID 1000) so files written into a
# bind-mounted vault belong to the same user as Syncthing's.
RUN mkdir -p /data && chown node:node /data
ENV DATA_DIR=/data
USER node
EXPOSE 8787
CMD ["node", "dist/main.js"]
